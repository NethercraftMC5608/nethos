#!/usr/bin/env python3
"""Read or change the desktop appearance without reloading open applications."""
import json
import os
from pathlib import Path
import sys
import urllib.request

path = Path(os.environ.get('XDG_CONFIG_HOME', str(Path.home() / '.config'))) / 'nethos/settings.json'
try:
    settings = json.loads(path.read_text())
except (OSError, ValueError):
    settings = {}
if len(sys.argv) == 1:
    print(settings.get('theme', 'dark'))
    sys.exit(0)
theme = sys.argv[1]
if theme not in ('light', 'dark', 'auto'):
    sys.exit('usage: nethos-theme [light|dark|auto]')
try:
    request = urllib.request.Request('http://127.0.0.1:7777/api/settings',
        data=json.dumps({'theme': theme}).encode(), headers={'Content-Type': 'application/json'}, method='POST')
    with urllib.request.urlopen(request, timeout=3) as response:
        response.read()
except OSError:
    settings['theme'] = theme
    path.parent.mkdir(parents=True, exist_ok=True)
    temporary = path.with_suffix('.tmp')
    temporary.write_text(json.dumps(settings, indent=2))
    temporary.replace(path)
    (path.parent / 'theme').write_text(theme + '\n')
print('theme: ' + theme)
