# What nk needs switched on in Linux, beyond arch/lkl's defconfig.
#
# Appended and re-resolved with olddefconfig on every build, so adding a line
# here is enough -- the tree is a docker volume that survives between builds
# and its .config would otherwise be whatever the first build decided.

# The early console registers at early_initcall rather than core_initcall,
# which is a long way earlier in start_kernel. Without it a boot that fails
# before core_initcall produces no output at all, which is indistinguishable
# from one that never started.
CONFIG_LKL_EARLY_CONSOLE=y

# Explicitly off, not merely absent. This file is appended to .config and
# resolved with olddefconfig, which can turn an option on and cannot turn one
# off by omission -- so reverting an experiment means saying so here, or the
# volume keeps whatever the experiment set for ever.
# CONFIG_MMU is not set

# Graphics is not here, and what stops it is written down rather than guessed.
#
# DRM_VIRTIO_GPU depends on MMU -- arch/lkl has its own MMU implementation and
# it is off by default. Turning it on builds, and then Linux dies in
# bootmem_init jumping through a null pointer, because with MMU the very first
# thing it does is
#
#     lkl_ops->shmem_init(mem_size);
#     lkl_ops->shmem_mmap(lkl_va_base, 0, mem_size, prot);
#
# and nk implements neither. On a Unix host those are a shared memory object
# and mmap of it; what they mean is that Linux wants to map the same physical
# memory at more than one virtual address, which is exactly what an MMU is
# for and exactly what nk has not offered it. nk has page tables and could,
# but it is a piece of work and not a config line.
#
# So: no DRM, and therefore no Mesa, until nk gives Linux virtual memory of
# its own. See docs/KERNEL.md, "What this means for graphics".
#
# CONFIG_DRM=y
# CONFIG_DRM_VIRTIO_GPU=y
# CONFIG_FB=y
# CONFIG_DRM_FBDEV_EMULATION=y
