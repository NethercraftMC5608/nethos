# What nk needs switched on in Linux, beyond arch/lkl's defconfig.
#
# Appended and re-resolved with olddefconfig on every build, so adding a line
# here is enough -- the tree is a docker volume that survives between builds
# and its .config would otherwise be whatever the first build decided.

# The early console registers at early_initcall rather than core_initcall,
# which is a long way earlier in start_kernel. Without it a boot that fails
# before core_initcall produces no output at all, which is indistinguishable
# from one that never started.
CONFIG_LKL_EARLY_CONSOLE=y

# Linux manages its own virtual memory. This is what DRM_VIRTIO_GPU depends
# on, and it needs four host operations nk did not have -- shmem_init,
# shmem_mmap, mmap and munmap -- because Linux wants the same physical page
# mapped at more than one virtual address and nk is the only thing that can
# do that. Its linear map goes at six gigabytes and its vmalloc arena at four,
# both above everything nk occupies; see kernel/ldk/patch-lkl.py.
CONFIG_MMU=y
# The addresses themselves are not here. LKL_MEMORY_START and
# LKL_TASK_UNMAPPED_BASE are hex symbols with no prompt, so Kconfig takes
# their value from the `default` line and ignores anything .config says --
# silently. kernel/ldk/patch-lkl.py moves the defaults instead.

# Explicitly off, not merely absent. This file is appended to .config and
# resolved with olddefconfig, which can turn an option on and cannot turn one
# off by omission -- so reverting an experiment means saying so here, or the
# volume keeps whatever the experiment set for ever.

# No LKL PCI, and therefore no LKL DMA ops.
#
# arch/lkl's PCI support selects ARCH_HAS_DMA_OPS, which makes lkl_dma_ops the
# DMA implementation for *every* device -- and lkl_dma_ops is written for
# LKL's PCI host: it calls lkl_ops->pci_ops->map_page and casts the device to
# a struct pci_dev. nk has no pci_ops, so a modern virtio device, which unlike
# a legacy one does use the DMA API, dereferences null inside the kernel the
# moment it maps a scatterlist.
#
# Without it Linux uses dma-direct, which is exactly right here: Linux's
# linear map is identity with real physical memory, so a DMA address is a
# physical address and there is nothing to translate. nk's devices are MMIO
# and LKL's PCI host probe already fails with -1 -- nothing is lost.
# CONFIG_PCI is not set

# Graphics. virtio-gpu is a virtio-mmio device like the disk, and nk hands it
# to Linux the same way. It depends on MMU, which is why the section above
# exists.
CONFIG_DRM=y
CONFIG_DRM_VIRTIO_GPU=y

# fbdev emulation on top of DRM. This is what makes first pixels possible
# without shared file-backed mmap: /dev/fb0 can be drawn on with an ordinary
# write(), where a DRM dumb buffer has to be mapped, and mapping is the harder
# thing and not nk's yet.
CONFIG_FB=y
CONFIG_DRM_FBDEV_EMULATION=y

# The framebuffer console is deliberately *not* enabled, and it was tried.
#
# Writing to /dev/fb0 fills a shadow buffer; something has to set a mode on
# the CRTC before the device scans any of it out, and without that QEMU shows
# "Display output is not active" over a black screen. fbcon does that on an
# ordinary Linux. Here it also takes the system console: with CONFIG_VT the
# kernel log stops reaching nk's serial port entirely, which is every test's
# only view of the boot, and the guest hung after drawing. Turning the display
# on is worth doing with a KMS modeset from userspace instead -- one ioctl
# against /dev/dri/card0, and nothing else changes.

# Device nodes that exist because the driver said so, rather than because
# something guessed a major and minor and ran mknod. /dev/dri/card0 and
# /dev/fb0 arrive this way.
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# Sockets and shared memory the desktop needs.
#
# arch/lkl's defconfig leaves CONFIG_UNIX off, so socketpair(AF_UNIX)
# fails with EAFNOSUPPORT even though the forwarding is fine -- the
# family is simply not compiled in. Wayland is an AF_UNIX socket and
# wl_shm is memfd_create plus MAP_SHARED, so a kernel without these
# cannot run a compositor no matter what nk forwards.
CONFIG_UNIX=y
CONFIG_TMPFS=y
CONFIG_MEMFD_CREATE=y
